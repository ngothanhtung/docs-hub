NODE_ENV=development
PORT=4999
# URL của web Next.js, dùng cho CORS
WEB_URL=http://localhost:3999

DATABASE_URL=postgresql://docshub:docshub@localhost:5432/docshub?schema=public

# Tạo bằng: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Production: .ten-mien.vn để Next.js (app.) đọc được cookie của API (api.)
COOKIE_DOMAIN=

# Cho phép tự đăng ký tài khoản (học viên vẫn phải được ghi danh vào khoá)
ALLOW_SIGNUP=true

# Đăng nhập Google (Google Identity Services). Bỏ trống thì tắt.
GOOGLE_CLIENT_ID=

# Tài khoản admin tạo bởi `pnpm db:seed`
SEED_ADMIN_EMAIL=admin@docshub.local
SEED_ADMIN_PASSWORD=Admin@123456

# Lưu ảnh (S3). Dev dùng RustFS trong docker-compose; production dùng AWS S3 (bỏ trống S3_ENDPOINT).
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=docshub-assets
S3_ACCESS_KEY_ID=docshub
S3_SECRET_ACCESS_KEY=docshub-dev-secret
# true với RustFS/MinIO; AWS S3 để false
S3_FORCE_PATH_STYLE=true

# Tìm kiếm
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=docshub-dev-master-key
MEILI_INDEX=docshub_docs
