        {
          "name": "Autosave bản nháp",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/docs/{{docId}}/draft",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "docs",
                "{{docId}}",
                "draft"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"---\\ntitle: Provider và Dependency Injection\\nslug: provider\\nsidebar_position: 1\\n---\\n\\n:::tip[Ghi nhớ]\\nProvider được tiêm qua constructor.\\n:::\\n\\n## Tạo provider\\n\\n```ts title=\\\"cats.service.ts\\\" {1}\\n@Injectable()\\nexport class CatsService {}\\n```\\n\\nCông thức $E = mc^2$.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Autosave: chỉ ghi bản nháp, không tạo revision. Title/slug/sidebar_position đồng bộ từ frontmatter."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const doc = pm.response.json().doc;",
                  "pm.collectionVariables.set(\"docSlug\", doc.slug);",
                  "pm.collectionVariables.set(\"sourceUpdatedAt\", doc.sourceUpdatedAt);"
                ]
              }
            }
          ]
        },
        {
          "name": "Lưu (Ctrl+S) tạo revision",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/docs/{{docId}}/draft",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "docs",
                "{{docId}}",
                "draft"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"---\\ntitle: Provider và Dependency Injection\\nslug: provider\\nsidebar_position: 1\\n---\\n\\n:::tip[Ghi nhớ]\\nProvider được tiêm qua constructor.\\n:::\\n\\n## Tạo provider\\n\\n```ts title=\\\"cats.service.ts\\\" {1}\\n@Injectable()\\nexport class CatsService {}\\n```\\n\\nCông thức $E = mc^2$.\",\n  \"baseUpdatedAt\": \"{{sourceUpdatedAt}}\",\n  \"createRevision\": true,\n  \"message\": \"Bản đầu tiên\"\n}",
              "options": {
                "raw": {
                  "language": "json"
