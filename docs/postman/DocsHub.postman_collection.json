{
  "info": {
    "name": "DocsHub API",
    "description": "Luồng chính của DocsHub API. Chạy theo thứ tự từ trên xuống (Run collection). Token và id được tự lưu vào biến collection sau mỗi request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "learnerToken",
      "value": ""
    },
    {
      "key": "learnerId",
      "value": ""
    },
    {
      "key": "learnerEmail",
      "value": ""
    },
    {
      "key": "courseId",
      "value": ""
    },
    {
      "key": "courseSlug",
      "value": ""
    },
    {
      "key": "versionId",
      "value": ""
    },
    {
      "key": "versionSlug",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "categorySlug",
      "value": ""
    },
    {
      "key": "docId",
      "value": ""
    },
    {
      "key": "docSlug",
      "value": ""
    },
    {
      "key": "sourceUpdatedAt",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"DB up\", () => pm.expect(pm.response.json().database).to.eql(\"up\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Đăng nhập admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Admin được tạo bởi `pnpm db:seed`. Lưu access token vào biến `accessToken` (dùng mặc định cho mọi request)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"accessToken\", body.accessToken);",
                  "pm.collectionVariables.set(\"adminToken\", body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Thông tin tài khoản (me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Là admin\", () => pm.expect(pm.response.json().systemRole).to.eql(\"ADMIN\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token (dùng cookie)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Không cần body: Postman tự gửi cookie `docshub_rt` nhận được lúc đăng nhập. Mỗi lần gọi, cookie được xoay sang token mới."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"accessToken\", pm.response.json().accessToken);",
                  "pm.collectionVariables.set(\"adminToken\", pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Đăng ký học viên",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{learnerEmail}}\",\n  \"password\": \"Matkhau@123\",\n  \"name\": \"Học viên Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Pre-request script tạo email ngẫu nhiên để chạy lại collection nhiều lần không bị trùng."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"learnerEmail\", `hocvien.postman.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"learnerToken\", body.accessToken);",
                  "pm.collectionVariables.set(\"learnerId\", body.user.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Users (admin)",
      "item": [
        {
          "name": "Danh sách người dùng",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?q=postman",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "postman"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cấp quyền giảng viên",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{learnerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{learnerId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"systemRole\": \"USER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Đổi `systemRole` thành `INSTRUCTOR` để người đó được tạo khoá học. Ví dụ này giữ `USER` cho học viên."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
