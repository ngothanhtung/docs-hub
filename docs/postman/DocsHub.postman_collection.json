                  "pm.collectionVariables.set(\"courseSlug\", body.slug);",
                  "pm.collectionVariables.set(\"versionId\", body.versions[0].id);",
                  "pm.collectionVariables.set(\"versionSlug\", body.versions[0].slug);"
